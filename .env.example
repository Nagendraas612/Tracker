# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/sih_tracker

# Authentication Secrets
NEXTAUTH_SECRET=sih-tracker-super-secret-key-32chars-min
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials (Optional for Demo Mode, required for real Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ntfy Push Notification Gateway
NTFY_SERVER_URL=https://ntfy.sh

# Continuous Monitoring Worker Interval (in milliseconds)
POLL_INTERVAL_MS=30000

# Development / Demo Mode (allows simulated counts & instant testing)
DEMO_MODE=false
